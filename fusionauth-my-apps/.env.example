# FusionAuth OIDC - tenant-scoped issuer.
# The tenant id path segment selects which tenant's applications and users apply.
FUSION_AUTH_ISSUER=http://localhost:9011/5d257d48-c921-0e03-561d-0687bcaa54b7

# Credentials for THIS launcher app, registered as a Regular Web Application
# (confidential client) in FusionAuth. The authorized redirect URI must be
# ${APP_BASE_URL}/callback - the app prints the exact value it expects on startup.
FUSION_AUTH_CLIENT_ID=your_launcher_client_id
FUSION_AUTH_CLIENT_SECRET=your_launcher_client_secret
FUSION_AUTH_SCOPES=openid profile email

# FusionAuth management API.
#
# NOTE: these endpoints do NOT accept the user's access token - they require an
# API key. Create one in the FusionAuth admin UI (API Keys) and keep it in .env.
FUSION_AUTH_API_KEY=your_fusion_auth_api_key

# Sent as the X-FusionAuth-TenantId header. An API key is not itself bound to a
# tenant, so without this header every management API call fails with
# [TenantIdRequired].
FUSION_AUTH_TENANT_ID=5d257d48-c921-0e03-561d-0687bcaa54b7

# Optional override for the management API origin. Defaults to the origin of
# FUSION_AUTH_ISSUER, which is correct for a single-instance install.
#FUSION_AUTH_API_URL=http://localhost:9011

# App
APP_PORT=3000
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=change_me_in_prod
