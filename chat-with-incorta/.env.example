# Incorta (API Authentication - OIDC)
INCORTA_CLIENT_ID=your_incorta_oauth_client_id
INCORTA_CLIENT_SECRET=your_incorta_oauth_client_secret
INCORTA_OIDC_ISSUER=http://localhost/incorta/oauth/demo_sso
# Base URL used for the Incorta REST API calls (defaults to http://localhost)
INCORTA_BASE_URL=http://localhost
# Tenant (project) segment in the REST API path:
#   {INCORTA_BASE_URL}/incorta/api/v2/{INCORTA_TENANT}/schema/list
# Defaults to the last segment of INCORTA_OIDC_ISSUER if left empty.
INCORTA_TENANT=demo_sso

# Incorta Copilot A2A agent (drives the chat window)
# Agent name in /copilot/a2a/agent/<name>:
#   {INCORTA_BASE_URL}/incorta/api/v2/{INCORTA_TENANT}/copilot/a2a/agent/{INCORTA_A2A_AGENT}
INCORTA_A2A_AGENT=smart-agent
# Output extensions requested via the x-a2a-extensions header. Unset uses the
# four defaults; set to empty to send no extensions header at all.
#INCORTA_A2A_EXTENSIONS=
#INCORTA_A2A_VERBOSITY=detailed
#INCORTA_A2A_ENABLE_SUMMARY=true
#INCORTA_A2A_TIMEOUT_MS=120000
#INCORTA_A2A_MAX_MESSAGE_LENGTH=8000
# Model the Copilot should use, sent as client_context.params model_key. Leave
# unset to use Incorta's own default model.
INCORTA_A2A_MODEL_KEY=claude-opus-5-5
# Polled chat page (/copilot): how often to poll a task, and when to give up (ms)
#INCORTA_COPILOT_POLL_MS=2000
#INCORTA_COPILOT_TIMEOUT_MS=300000

# User Authentication - any OpenID Connect provider (Keycloak, Okta, Auth0, ...)
# Issuer URL; <issuer>/.well-known/openid-configuration must be reachable.
OIDC_ISSUER=http://localhost:8888/realms/incorta
OIDC_CLIENT_ID=your_oidc_client_id
# Public client (PKCE only) - leave empty unless the client is made confidential
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
# Optional: name shown on the login button and in logs (default: SSO)
#OIDC_PROVIDER_LABEL=Keycloak
# Optional: claim holding the user's email, sent to Incorta as for_user (default: email)
#OIDC_EMAIL_CLAIM=email

# App Config
APP_PORT=3000
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=change_me_in_prod
# Log full access tokens (Incorta and the identity provider) to the server log.
# Defaults to off: a masked fingerprint is logged instead. Tokens are bearer
# credentials and logs are widely readable, so only enable this locally.
LOG_ACCESS_TOKENS=false
